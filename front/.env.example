# URL base da API usada pelo PHP do front (CurlHelper) — chamada server-side,
# por isso usa o nome do serviço nginx dentro da rede Docker
API_BASE_URL=http://nginx/api

# Timeout (em segundos) das chamadas do front para a API
API_TIMEOUT=10

# Tempo de vida da sessão em minutos — mantenha igual ao JWT_EXPIRATION_MINUTES do back/.env
SESSION_LIFETIME=60

# Minutos após o token expirar em que o front ainda tenta renová-lo (POST /api/auth/refresh)
# — mantenha igual ao JWT_REFRESH_GRACE_MINUTES do back/.env
SESSION_REFRESH_GRACE=30

# Força o flag Secure no cookie de sessão (ative em produção com HTTPS).
# Mesmo em false, o flag é ligado automaticamente quando a requisição chega via HTTPS.
SESSION_SECURE_COOKIE=false

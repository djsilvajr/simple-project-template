# --- Aplicação ---------------------------------------------------------------
APP_NAME=api
APP_ENV=local
APP_PORT=8080
APP_DEBUG=false

# Loga o body das requisições (campos password/senha/token/secret são mascarados)
LOG_REQUEST_BODY=false

# Lê o IP do cliente de X-Real-IP / X-Forwarded-For (ative só atrás do nginx)
TRUST_PROXY=true

# --- Banco de dados (MySQL) --------------------------------------------------
# Use o nome do serviço do docker-compose como host.
# DB_DATABASE, DB_USERNAME e DB_PASSWORD devem ser IGUAIS aos do .env da raiz
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mydb
DB_USERNAME=myuser
DB_PASSWORD=mypassword
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=5

# --- Autenticação ------------------------------------------------------------
# Chave de assinatura do JWT (troque por uma string longa e aleatória)
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
# Mantenha igual ao SESSION_LIFETIME do front/.env
JWT_EXPIRATION_MINUTES=60

# Janela (minutos) após a expiração em que o token ainda pode ser renovado em POST /auth/refresh
# Mantenha igual ao SESSION_REFRESH_GRACE do front/.env
JWT_REFRESH_GRACE_MINUTES=30

# Pepper aplicado à senha antes do bcrypt (trocar invalida todas as senhas)
PASSWORD_SECRET=troque-por-outra-chave-longa-e-aleatoria

# --- Rate limit (por IP) -----------------------------------------------------
RATE_LIMIT_ENABLED=true
# Fichas repostas por segundo (ritmo sustentado) e máximo acumulado (pico)
RATE_LIMIT_REQUESTS_PER_SECOND=30
RATE_LIMIT_BURST=30

# --- CORS --------------------------------------------------------------------
# Lista separada por vírgula. "*" libera qualquer origem.
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=600

# --- E-mail (SMTP) -----------------------------------------------------------
# Com MAIL_ENABLED=false os e-mails são apenas escritos no log
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# --- Seeder ------------------------------------------------------------------
# Usuário admin criado por "migration -seed" (não é criado se a senha estiver vazia)
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=senha12345
